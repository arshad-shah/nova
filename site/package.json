{
  "name": "verql-site",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Documentation site for Verql — deployed at https://verql.arshadshah.com",
  "license": "MIT",
  "author": "Arshad Shah",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.10.0"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "prebuild": "node ../scripts/brand/build-brand.mjs --svg-only",
    "build": "astro build && pnpm run build:storybook",
    "build:storybook": "cd .. && pnpm install --frozen-lockfile --ignore-scripts && pnpm exec storybook build -o site/dist/storybook",
    "preview": "astro preview",
    "check": "astro check",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.39.3",
    "astro": "^6.4.6",
    "mermaid": "^11.15.0",
    "sharp": "^0.35.0"
  },
  "pnpm": {
    "overrides": {
      "dompurify@<3.4.11": ">=3.4.11",
      "esbuild@<0.28.1": ">=0.28.1"
    }
  }
}
